# ─── BK-Ingest environment ───────────────────────────────────────────
# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Anthropic (Stage 0 triage classification, extraction, vision probe)
ANTHROPIC_API_KEY=

# MongoDB — registries, ledger, queues (dbName is set in code: bkIngest)
MONGODB_URI=mongodb+srv://<user>:<db_password>@cluster0.acb629h.mongodb.net/?appName=Cluster0

# Cloudinary (Stage 7 media — not needed until Milestone E)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# API
PORT=5000
NODE_ENV=development
