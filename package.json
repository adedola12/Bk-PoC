{
  "name": "bk-ingest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BuildersKonnect AI catalog-onboarding PoC (BK-Ingest)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
