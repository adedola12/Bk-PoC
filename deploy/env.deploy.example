# Copy to deploy/.env.deploy (gitignored) and adjust if needed.
#
# This file holds DEPLOYMENT configuration only — no application secrets.
# Application secrets (MONGODB_URI, ANTHROPIC_API_KEY, Cloudinary) go into
# deploy/.env.migration, which is generated by deploy/write-env-migration.sh
# from environment variables and never committed.
#
# The values below are ADLM's actual PoC settings, not placeholders — copying
# this file as-is is correct for BK-Ingest.

# ─── AWS ───
# eu-west-1 (Ireland): full service coverage, cheapest tier, reasonable latency
# to Lagos. af-south-1 is geographically closer but needs opt-in, costs more,
# and is not better connected to West Africa. The frontend is served from
# CloudFront edge locations regardless of this choice.
AWS_REGION=eu-west-1
ECR_REPO=bk-ingest-api

# Name of an EXISTING EC2 key pair in the region above. Create one first:
#   aws ec2 create-key-pair --key-name bk-ingest --query KeyMaterial \
#     --output text > ~/.ssh/bk-ingest.pem && chmod 600 ~/.ssh/bk-ingest.pem
# Without it you cannot SSH to the box, and go-live.sh cannot deploy.
SSH_KEY_NAME=bk-ingest

# t3.small (2GB). t3.micro's 1GB OOMs when pdfjs rasterizes the 104-page
# handbook under vision extraction — do not downgrade this to save $8.
EC2_INSTANCE_TYPE=t3.small

# Filled in automatically by 03-provision-infra.sh after the first run.
ECR_IMAGE=

# ─── API host ───
# Must resolve to the EC2 Elastic IP. Caddy cannot issue a Let's Encrypt
# certificate for a bare IP address, and the CloudFront frontend is HTTPS, so
# a plain-HTTP API would be blocked by the browser as mixed content.
# 03-provision-infra.sh creates this record automatically if the parent zone
# (adlmstudio.com) is hosted in this account's Route 53.
API_DOMAIN=api-bk.adlmstudio.com

# ─── Frontend (S3 + CloudFront) ───
# S3 bucket names are globally unique across all AWS accounts.
FRONTEND_BUCKET=bk-poc-frontend-adlm

# Filled in automatically by 03-provision-infra.sh.
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_DOMAIN=
