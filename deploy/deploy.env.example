# Copy to deploy/deploy.env (gitignored) and set for your account.
# Every value here is infrastructure config, not a secret — secrets live in
# Parameter Store and are written by deploy/write-env-migration.sh.
# Anything already exported in your shell wins over these.

# AWS region holding the parameters and the API instances
AWS_REGION=eu-west-1

# Parameter Store prefix — each var lands at $SSM_PREFIX/<NAME>
SSM_PREFIX=/bk-poc/prod

# Which instances to deploy to (tag filter, so instance replacement is transparent)
TARGET_TAG_KEY=Name
TARGET_TAG_VALUE=bk-ingest-api

# systemd unit serving the API, and the EnvironmentFile it reads
SERVICE_NAME=bk-ingest-api
REMOTE_ENV_FILE=/etc/bk-ingest/api.env

# Health probe run on the instance after the restart
HEALTH_URL=http://127.0.0.1:5000/healthz

# Give up on the SSM command after this long
SSM_TIMEOUT_SECONDS=600
