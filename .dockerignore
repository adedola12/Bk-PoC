# Build context for server/Dockerfile is the REPO ROOT, because routes/emit.js
# reads fixtures/ which lives above server/. Everything the API does not need
# at runtime is excluded here — without this the context would include .git and
# client/node_modules, which is slow to send and bloats the image.
#
# Two things must NOT be excluded:
#   fixtures/    the BK template + Twyford golden file, read by routes/emit.js
#   server/eval/ routes/pipeline.js imports eval/injector.js at runtime

.git
.github
.claude

# frontend ships to S3/CloudFront, never into the API image
client

docs
deploy
media
ground-truth

**/node_modules
**/npm-debug.log
**/.env
**/.env.*

# run artifacts and uploads are runtime state, recreated in the container
runs
uploads
server/runs
server/uploads

# not exercised in production
server/test
server/scripts

**/*.md
.DS_Store
